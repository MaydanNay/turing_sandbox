# PostgreSQL
POSTGRES_USER=bunker
POSTGRES_PASSWORD=bunker
POSTGRES_DB=turing_sandbox
DATABASE_URL=postgresql+asyncpg://bunker:bunker@postgres:5432/turing_sandbox

# Redis
# In Docker Compose the API talks to service hostname `redis:6379`.
# For local (non-Docker) uvicorn use: redis://localhost:6380/0
REDIS_URL=redis://redis:6379/0

# App
APP_HOST=0.0.0.0
APP_PORT=8000
# Minimum human players before mock bots fill the room
MIN_HUMAN_PLAYERS=1
# Target total seats (humans + bots)
ROOM_CAPACITY=8
# Isolation slots; survivors board convoy (8 - 3 = 5)
BRIG_CAPACITY=3
CONVOY_SEATS=5
CONVOY_BOARDING_SECONDS=180
# AI seats that are SYNTHETIC (system-only; agents think they are human)
SYNTHETIC_COUNT=2
CORS_ORIGINS=*

# Match phase clock (1.0 = full design lengths from gamePhaseConfig)
# 0.2 keeps local playtests moving (~1–1.5 min per table round)
PHASE_DURATION_SCALE=0.2
PHASE_SCHEDULER_INTERVAL_SECONDS=1.0
# Seconds to wait for other humans before filling AI seats
MATCHMAKING_SECONDS=30

# Helixa game-agent (Live private chat / кулуары)
# HELIXA_BASE_URL=http://host.docker.internal:8000
HELIXA_BASE_URL=http://localhost:8000
HELIXA_INTERNAL_TOKEN=
HELIXA_TIMEOUT_SECONDS=4.0
HELIXA_RESOLVE_TIMEOUT_SECONDS=2.5
HELIXA_ENABLED=true
