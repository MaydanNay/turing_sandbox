# API base URL (browser-side). Use relative /api when Vite proxy is enough.
# Default backend port in this repo: 8003 (8001 is often taken by saas-django).
VITE_API_URL=http://localhost:8003

# WebSocket base URL. Use ws://localhost:8003 or explicit WSL IP if localhost times out.
# Example WSL IP: ws://172.22.123.45:8003
VITE_WS_URL=ws://localhost:8003

# Vite dev-server proxy target (WSL IP injection for Windows browser → WSL backend)
VITE_API_PROXY_TARGET=http://localhost:8003

# Scene / walk editor (?walkEdit=1). Client-visible — local only.
VITE_SCENE_EDITOR_PASSWORD=admin123
